<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../datasets/core.json" Link="datasets/core.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../eval-thresholds.json" Link="eval-thresholds.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
